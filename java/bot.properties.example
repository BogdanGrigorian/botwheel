# Copy this file to bot.properties and fill in your values.
# bot.properties is git-ignored (it contains the bot token).

# Required: token from @BotFather
telegram.bot.token=1234567890:AA...replace-me...

# GitHub Pages URL of the Mini App (public/ folder)
telegram.miniapp.url=https://bogdangrigorian.github.io/botwheel/

# Optional: a pre-generated vault container (VLT3) used as the seed for a new
# user. On that user's first /start the bot splits it into one row per record.
# Leave empty to start with empty vaults.
telegram.seed.file=test-vault.txt

# Optional: comma/space-separated list of Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone.
telegram.allowed.user.ids=

# Optional: embedded H2 database location for the stored records.
# Relative paths are resolved against the working directory; H2 appends .mv.db.
telegram.db.path=botwheel-db

# Optional: server-side "at rest" encryption of the stored header and records.
# The bot wraps each stored value with this key before writing it to the database
# and unwraps it only to assemble the vault container over chat. This protects the
# DB file if it is stolen (backups, disk dumps) — the key is a SEPARATE asset.
#
# Provide the key either inline (base64, 32 bytes) ...
# telegram.db.key=
# ... or as a key file (created automatically if missing). Default is a sibling
# "<db>.key". For real key/DB separation, point this at another volume/folder.
# Set to "off" to disable at-rest encryption.
telegram.db.key.file=botwheel-db.key
