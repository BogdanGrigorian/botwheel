# Copy this file to bot.properties and fill in your values.
# bot.properties is git-ignored (it contains the bot token).

# Required: token from @BotFather
telegram.bot.token=1234567890:AA...replace-me...

# GitHub Pages URL of the Mini App (public/ folder)
telegram.miniapp.url=https://bogdangrigorian.github.io/botwheel/

# Optional: a pre-generated VLT1 vault blob used as the demo seed for new users.
# Leave empty to start with empty vaults.
telegram.seed.file=test-vault.txt

# Optional: comma/space-separated list of Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone.
telegram.allowed.user.ids=
